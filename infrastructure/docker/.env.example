# Copy this file to .env and fill in your values before running docker-compose

# URLs baked into the React build. Local docker-compose publishes the backend on 8004.
# For a public deploy, swap in your Cloudflare Tunnel / ngrok host (https:// and wss://).
# REACT_APP_WS_URL must be an origin only — the app appends /api/v1/... itself.
REACT_APP_API_URL=http://localhost:8004/api/v1
REACT_APP_WS_URL=ws://localhost:8004
