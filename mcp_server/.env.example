# Enterprise PM System - MCP Server Configuration
# Copy this file to .env and fill in your values

# API base URL (no trailing slash). Local backend by default;
# swap in your deployed/tunnel host to reach a remote instance.
PM_API_URL=http://localhost:8001/api/v1

# Optional: pre-set JWT token (get it from the app's login response or use the login() tool)
# If not set, call the login() tool first before using other tools.
PM_API_TOKEN=
